# ---------------------------------------------------------------------------
# NIST Compass — environment variables
# Copy this file to `.env.local` and fill in the values from your Supabase
# project (Project Settings -> API).
# ---------------------------------------------------------------------------

# Public Supabase project URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public anon key (safe to expose; protected by Row Level Security)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — SERVER ONLY. Never expose to the browser.
# Used by trusted server actions/route handlers that must bypass RLS
# (e.g. signed-URL generation, admin seeding). Leave unset in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL, used for auth email redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
